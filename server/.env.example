# Railway injects DATABASE_URL and PORT automatically.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# OpenAI (server-side only — never in the app)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Cognito (to verify the app's id tokens) — from the mirra-backend stack
COGNITO_USER_POOL_ID=us-east-1_ufMj606bz
COGNITO_CLIENT_ID=2880m1ablar95qk6nfrpuuecg8
AWS_REGION=us-east-1

# S3 for theme image uploads (presigned PUT). Use the `Mirra` IAM user's keys.
S3_BUCKET=mirra-affirmation-bucket
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
